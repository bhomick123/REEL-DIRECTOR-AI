# .env.example
# ==============================================================================
# SERVER-SIDE SECRETS (Never expose to client / Never prefix with VITE_)
# ==============================================================================

# Google Gemini API key for multimodal video, photo, and creative direction analysis
GEMINI_API_KEY=

# Base application URL (e.g., https://my-app.run.app or http://localhost:3000)
APP_URL=

# Google OAuth 2.0 Credentials (for official creator authentication)
# Client ID is safe for OAuth redirect flow; Client Secret is a strict server-only secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Meta for Developers / Instagram Graph API OAuth Credentials
# Client ID is Meta App ID; Client Secret is a strict server-only secret
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
